# ─────────────────────────────────────────────────────────────────────────────
# DENY BY DEFAULT. Ignore everything at the repo root, then re-include only what
# ships. Anything not on the allowlist (data, run outputs, envs, caches, secrets)
# is ignored automatically and can never be committed by accident.
# To ship something new at the root, add an explicit `!` exception.
# ─────────────────────────────────────────────────────────────────────────────

# 1) ignore everything at the root
/*

# 2) the folders that ship
!/.claude/
!/.codex/
!/agents/
!/analysis/
!/docs/
!/graph/
!/kits/
!/results/
!/tasks/
!/tools/
!/training/

# 3) the root files that ship
!/.env.example
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/LICENSE
!/Makefile
!/README.md
!/control.md
!/journal.md
!/pyproject.toml
!/uv.lock

# 4) local-only things inside shipped folders
#    (data/, runs/, envs/, refs/ are not re-included above, so they stay local)
.claude/settings.local.json
.claude/projects/
.claude/worktrees/
.codex/config.toml
.codex/projects
kits/swe-agent/sandbox/setup.py
kits/swe-agent/sandbox/wheels_extra/
__pycache__/
*.pyc
*.egg-info/
.ipynb_checkpoints/
*.parquet
*.ckpt
*.pt

# 5) secrets stay ignored even if section 1 is ever loosened
.env
.env.*
*.env
kaggle.json
.kaggle/
MEMORY.md

# 6) ...but the credential TEMPLATE ships (no secrets in it). Last so it beats `.env.*`.
!.env.example

# kaggleforge — Kaggle credentials.
# Copy this file to .env and fill in your values. NEVER commit .env (it's git-ignored).
# Get both values at: kaggle.com → Settings → "Create New Token" (downloads kaggle.json).

KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key
HF_TOKEN=your-huggingface-api-key
# Cloudflare R2 (S3 API) for the task-image registry, bucket gemma4-swe-images
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
